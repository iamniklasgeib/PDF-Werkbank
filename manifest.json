{
  "name": "PDF-Werkbank",
  "short_name": "PDF-Werkbank",
  "description": "PDFs öffnen, beschriften, unterschreiben, Seiten ordnen und zusammenführen.",
  "lang": "de",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#e4e8ee",
  "theme_color": "#2446c7",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
