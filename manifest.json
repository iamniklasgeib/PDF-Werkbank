          "type": "image/png"
        },
        {
          "src": "icons/file-pdf-48.png",
          "sizes": "48x48",
          "type": "image/png"
        },
        {
          "src": "icons/file-pdf-64.png",
          "sizes": "64x64",
          "type": "image/png"
        },
        {
          "src": "icons/file-pdf-128.png",
          "sizes": "128x128",
          "type": "image/png"
        },
        {
          "src": "icons/file-pdf-256.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ]
    }
  ]
}